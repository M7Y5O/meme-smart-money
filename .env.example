# Copy this file to .env and fill it in. Never commit .env to GitHub.

# --- Data (required) ---
# Free key at https://dashboard.helius.dev
HELIUS_API_KEY=

# --- X / Twitter (@MemeSmartMoney) ---
# developer.x.com > your app > Keys and tokens. App permissions must be "Read and write".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Telegram channel ---
# Create a bot with @BotFather, add it as an admin of your channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_channel_username

# Your Fomo referral link (only used on Telegram, never on X)
FOMO_REF_LINK=

# --- Fomo API: today's top traders (refreshed once a day) ---
# Leave FOMO_LEADERBOARD_URL empty to use wallets.json instead.
FOMO_LEADERBOARD_URL=
FOMO_API_KEY=
FOMO_AUTH_HEADER=Authorization
# e.g. "Bearer " (with the trailing space) if the API expects it
FOMO_AUTH_PREFIX=
# Where the list of traders sits in the JSON response, and which fields to read (dot paths)
FOMO_ITEMS_PATH=
FOMO_FIELD_NAME=username
FOMO_FIELD_WALLET=wallet
FOMO_FIELD_PNL=
FOMO_FIELD_X=
FOMO_TOP_N=25
# Shown in the weekly PnL post, e.g. "this week" (only if the API's PnL really is weekly)
PNL_PERIOD_LABEL=

# --- Behaviour ---
# Keep DRY_RUN=true until the printed posts look right, then set it to false.
DRY_RUN=true
POLL_SECONDS=180
CLUSTER_MIN_WALLETS=3
CLUSTER_WINDOW_HOURS=6
MIN_LIQUIDITY_USD=25000
MAX_X_POSTS_PER_DAY=8
RECAP_HOUR_ET=9
# 0=Monday ... 6=Sunday
WEEKLY_DAY=6
WEEKLY_HOUR_ET=10
BACKFILL_HOURS=24

WALLETS_FILE=wallets.json
DB_PATH=msm.sqlite3
